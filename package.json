{
  "name": "cairn",
  "productName": "Cairn",
  "version": "0.1.0",
  "description": "A local-first, cross-platform bookmark manager.",
  "main": "./out/main/index.js",
  "author": "Thomas Chester",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "predist": "node scripts/prepare-legal.mjs",
    "predist:win": "node scripts/prepare-legal.mjs",
    "predist:mac": "node scripts/prepare-legal.mjs",
    "predist:linux": "node scripts/prepare-legal.mjs",
    "legal": "node scripts/prepare-legal.mjs"
  },
  "dependencies": {
    "node-html-parser": "^9.0.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tabler/icons-react": "^3.47.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.34.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  }
}
